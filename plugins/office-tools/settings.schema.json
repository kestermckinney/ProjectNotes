{
  "fields": [
    {
      "key": "_help",
      "type": "note",
      "label": "Each template adds a menu to the right-click menu of the records of its Entity. The new document is saved in the project's folder, in the Output Folder given here, and added to the project's Files & Folders. When the record has no project folder, you are asked where to save it. Output Folder and File Name can use {{ entity.column }} values of the clicked record and its project, such as {{ projects.project_number }}, {{ template.name }}, {{ current.isoDate }}, and {{ input.name }}, which asks for a value when you create the document. Right-click the box and choose Insert Field to pick from the values available for the Entity."
    },
    {
      "key": "templates",
      "label": "Templates",
      "type": "table",
      "columns": [
        {
          "key": "menu",
          "label": "Menu",
          "type": "text"
        },
        {
          "key": "submenu",
          "label": "Submenu",
          "type": "text"
        },
        {
          "key": "entity",
          "label": "Entity",
          "type": "choice",
          "choices": [
            "projects",
            "contacts",
            "companies",
            "project_team",
            "project_locations",
            "project_notes",
            "meeting_attendees",
            "item_tracker",
            "item_tracker_updates",
            "status_report_items"
          ]
        },
        {
          "key": "template",
          "label": "Template",
          "type": "file",
          "filters": [
            "Office templates (*.docx *.docm *.doc *.dotx *.dotm *.xlsx *.xlsm *.xls *.xltx *.xltm *.pptx *.pptm *.potx *.potm *.mpp *.mpt *.xml)"
          ]
        },
