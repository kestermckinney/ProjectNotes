{
    "id": "com.projectnotespro.office-tools",
    "name": "MS Office Templates",
    "version": "3.0.0",
    "apiVersion": 1,
    "description": "Creates documents from the Word, Excel and PowerPoint templates you configure, filled in from the record you right-click, opens a project's schedule, and closes Excel or Word processes left behind by automation.",
    "author": "Project Notes",
    "main": "main.mjs",
    "platforms": ["windows"],
    "permissions": [
        "data.read:*",
        "data.write:project_locations",
        "files", "com", "urls", "ui.dialogs"
    ],
    "com": ["Word.Application", "Excel.Application", "PowerPoint.Application", "winmgmts:"],
    "contributes": {
        "menus": [
            { "id": "open-ms-project", "title": "Open MS Project", "context": "record", "entity": "projects",
              "include": ["project_locations"] },
            { "id": "kill-excel", "title": "Close Stranded Excel", "context": "global", "submenu": "Utilities" },
            { "id": "kill-word", "title": "Close Stranded Word", "context": "global", "submenu": "Utilities" }
        ],
        "settings": [
            { "id": "office", "title": "MS Office Templates", "schema": "settings.schema.json" }
        ]
    }
}
