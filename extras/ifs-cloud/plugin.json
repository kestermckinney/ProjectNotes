{
    "id": "com.projectnotespro.ifs-cloud",
    "name": "IFS Cloud",
    "version": "2.0.0",
    "apiVersion": 1,
    "description": "Imports your IFS Cloud projects, budgets and team members, keeps tracker items in step with the ISSUES activity tasks, generates SSRS status and tracker reports, and adds IFS shortcut menus.",
    "author": "Project Notes",
    "main": "main.mjs",
    "permissions": [
        "data.read:projects,project_team,item_tracker",
        "data.write:companies,contacts,projects,project_team,item_tracker",
        "http", "auth.browser", "files", "email.compose", "ui.dialogs", "com"
    ],
    "http": ["ifs.cornerstonecontrols.com", "indvifsbi05"],
    "com": ["Word.Application"],
    "legacySettings": [
        "IFS Cloud",
        { "group": "SSRS Generate", "prefix": "Ssrs" },
        { "group": "Tracker Report", "prefix": "Tracker" }
    ],
    "contributes": {
        "menus": [
            { "id": "import", "title": "Import IFS Projects", "context": "global", "submenu": "Utilities" },
            { "id": "status-report", "title": "Generate Status Report", "context": "record", "entity": "projects",
              "include": ["project_team"],
              "parameter": "/ReportServer/Pages/ReportViewer.aspx?%2fProd%2fLead+Engineers%2fProject+Status+Report&ProjectId={{ projects.project_number }}&StatusDate={{ report.date }}&ReportPeriod={{ projects.status_report_period }}" },
            { "id": "tracker-report", "title": "Generate Tracker Report", "context": "record", "entity": "projects",
              "include": ["project_team"],
              "parameter": "/ReportServer/Pages/ReportViewer.aspx?%2FProd%2FLead+Engineers%2FIssues+List&ProjectId={{ projects.project_number }}" }
        ],
        "settings": [
            { "id": "ifs", "title": "IFS Cloud", "schema": "settings.schema.json" }
        ]
    }
}
