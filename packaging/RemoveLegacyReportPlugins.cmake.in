# CMake directory installs and the Windows deploy copy both merge into their
# destination, so files removed from the source tree can otherwise survive an
# upgrade. Keep this cleanup narrowly scoped to the retired report plugins and
# the legacy Meeting and Email Types forms, all native as of 6.2.
#
# Run as an install(SCRIPT), or directly with
#   cmake -DPN_PLUGIN_ROOT=<deploy dir>/plugins -P RemoveLegacyReportPlugins.cmake
if(DEFINED PN_PLUGIN_ROOT)
    set(_pn_plugins_root "${PN_PLUGIN_ROOT}")
else()
    set(_pn_install_bindir "@CMAKE_INSTALL_BINDIR@")
    if(IS_ABSOLUTE "${_pn_install_bindir}")
        set(_pn_plugins_root "$ENV{DESTDIR}${_pn_install_bindir}/plugins")
    else()
        set(_pn_plugins_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${_pn_install_bindir}/plugins")
    endif()
endif()

foreach(_pn_legacy_plugin IN ITEMS
        "exportnotes_plugin"
        "exportstatusreport_plugin"
        "exporttrackeritems_plugin")
    set(_pn_legacy_source "${_pn_plugins_root}/${_pn_legacy_plugin}.py")
    if(EXISTS "${_pn_legacy_source}" OR IS_SYMLINK "${_pn_legacy_source}")
        message(STATUS "Removing retired report plugin: ${_pn_legacy_source}")
        file(REMOVE "${_pn_legacy_source}")
    endif()

    file(GLOB _pn_legacy_bytecode
        "${_pn_plugins_root}/__pycache__/${_pn_legacy_plugin}*.pyc"
        "${_pn_plugins_root}/__pycache__/${_pn_legacy_plugin}*.pyo"
    )
    if(_pn_legacy_bytecode)
        message(STATUS "Removing retired report plugin bytecode: ${_pn_legacy_plugin}")
        file(REMOVE ${_pn_legacy_bytecode})
    endif()
endforeach()

foreach(_pn_legacy_form IN ITEMS
        "dialogExportNotesOptions.ui"
        "dialogExportStatusReportOptions.ui"
        "dialogExportTrackerOptions.ui"
        "dialogMeetingEmailTemplate.ui"
        "dialogMeetingEmailTypes.ui")
    set(_pn_legacy_form_path "${_pn_plugins_root}/forms/${_pn_legacy_form}")
    if(EXISTS "${_pn_legacy_form_path}" OR IS_SYMLINK "${_pn_legacy_form_path}")
        message(STATUS "Removing retired plugin form: ${_pn_legacy_form_path}")
        file(REMOVE "${_pn_legacy_form_path}")
    endif()
endforeach()

unset(_pn_legacy_bytecode)
unset(_pn_legacy_form)
unset(_pn_legacy_form_path)
unset(_pn_legacy_plugin)
unset(_pn_legacy_source)
unset(_pn_plugins_root)
unset(_pn_install_bindir)
