<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build (cmake -DPN_APP_STORE=ON). See
         packaging/macos/AppStoreReviewNotes.md for why each entry is needed. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- The QML and JavaScript (plugin) engines compile to native code -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Cloud sync, Office 365, iCloud contacts and plugin web requests -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Browser sign-in returns to a listener on localhost (Office-style OAuth
         for services such as Keycloak). Loopback only. -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Project folders, File Finder locations and files the user picks, kept
         across restarts with security-scoped bookmarks. Also the direct
         download's data folder, which the user picks on the first start for
         DirectDownloadMigration to copy. No temporary exceptions. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- "MacOS Email and Calendar": events are saved through EventKit
         (MacEventKitCalendarBackend). Mail drafts go through NSSharingService
         and need no entitlement. No Apple Events: App Review does not grant
         the temporary exception (Guideline 2.4.5(i)). -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>

    <!-- Contact synchronization with the Contacts app -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
</dict>
</plist>
