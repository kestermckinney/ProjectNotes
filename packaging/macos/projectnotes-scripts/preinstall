#!/bin/sh

# pkg upgrades can merge a component bundle with the existing application, so
# plugins removed from a release can survive the upgrade and load again.
# Remove every bundled plugin, thread, form and helper that an earlier release
# shipped and this one dropped. Files are named one by one because the plugins
# folder can also hold the user's own plugins; it is never removed recursively.
#
# Keep this list in step with packaging/RemoveRetiredPlugins.cmake.in and
# packaging/windows/remove_retired_plugins.nsh.
target_volume="${3:-/}"
application_root="${target_volume%/}/Applications/Project Notes.app"

# Releases before 6.5.0 identified the app as com.projectnotespro.ProjectNotes.
# This one uses the iOS app's bundle ID, which it shares with the Mac App Store
# version, and so does its installer package, so macOS does not treat this as
# an upgrade. Remove a bundle with the old identifier so the new one is
# installed fresh rather than merged into it. Nothing of the user's lives in the bundle:
# data, settings and the user's plugins are all kept outside it.
old_identifier=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" \
    "${application_root}/Contents/Info.plist" 2>/dev/null || true)
if [ "${old_identifier}" = "com.projectnotespro.ProjectNotes" ]; then
    rm -rf "${application_root}"
fi

# Scripts, listed without .py so their cached bytecode goes too.
retired_scripts="
plugins/archivenotes_plugin
plugins/cci_connectdrives_plugin
plugins/cci_ifs_projects_import_plugin
plugins/cci_ifs_projects_statusreport_plugin
plugins/cci_scheduleoneonone_plugin
plugins/cci_scheduleoneononeattendee_plugin
plugins/cci_scheduleoneononeteam_plugin
plugins/contactexport_plugin
plugins/contactimport_plugin
threads/icloudsync_thread
plugins/copy_email_member_plugin
plugins/copy_email_plugin
plugins/copy_filepath_plugin
plugins/editor_plugin
plugins/email_as_attachment_plugin
plugins/emailarchive_plugin
plugins/exportnotes_plugin
plugins/exportstatusreport_plugin
plugins/exporttrackeritems_plugin
plugins/exporttrakeritems_plugin
plugins/findprojectemailperson_plugin
plugins/findprojectmailperson_plugin
plugins/globalsettings_plugin
plugins/ifs_cloud_projectsstatusreportfixed_plugin
plugins/ifs_cloud_settings_plugin
plugins/ifs_project_report_plugin
plugins/outlooksync_plugin
plugins/outlook-integration
plugins/paul_cleanpc_plugin
plugins/schedulecustomerkickoffinvite_plugin
plugins/schedulecustomerlessonslearnedinvite_plugin
plugins/schedulecustomerstatusinvite_plugin
plugins/scheduleinternalkickoffinvite_plugin
plugins/scheduleinternallessonslearnedinvite_plugin
plugins/scheduleinternalstatusinvite_plugin
plugins/sendmeetingnotes_plugin
plugins/sendprojectemail_plugin
plugins/sendprojectemailtoattendee_plugin
plugins/sendprojectemailtoperson_plugin
plugins/sendprojectemailtoteam_plugin
plugins/tester_plugin
plugins/tester_tools
plugins/trackkerreport_plugin
threads/filefinder_thread
threads/tester_thread_1
plugins/base_plugin
plugins/base_plugin_settings
plugins/excelkill_plugin
plugins/ifs_ssrs_generate_plugin
plugins/ifscloud_plugin_settings
plugins/myshortcuts_plugin
plugins/newchangeorder_plugin
plugins/newmsproject_plugin
plugins/newpcrregistry_plugin
plugins/newpowerpoint_plugin
plugins/newriskregister_plugin
plugins/open_msproject_plugin
plugins/projectnotes
plugins/team_member_quick_add_plugin
plugins/wordkill_plugin
plugins/includes/collaboration_tools
plugins/includes/common
plugins/includes/excel_tools
plugins/includes/graphapi_tools
plugins/includes/icloud_tools
plugins/includes/ifs_tools
plugins/includes/noteformatter
plugins/includes/outlook_tools
plugins/includes/settings_dialog
plugins/includes/word_tools
threads/ifssync_thread
threads/outlooksync_thread
plugins/includes/graphapitools
"

retired_files="
plugins/forms/dialogClassification.ui
plugins/forms/dialogExportNotesOptions.ui
plugins/forms/dialogExportStatusReportOptions.ui
plugins/forms/dialogExportTrackerOptions.ui
plugins/forms/dialogFileFinder.ui
plugins/forms/dialogMeetingEmailTemplate.ui
plugins/forms/dialogMeetingEmailTypes.ui
plugins/forms/dialogStatusRptOptions.ui
plugins/forms/dialogTrackerOptions.ui
plugins/forms/dialogTrackerRptOptions.ui
plugins/includes/dialogDuplicateFilesFound.ui
plugins/includes/dialogNotesArchiveOptions.ui
plugins/includes/dialogStatusRptOptions.ui
plugins/includes/dialogTrackerRptOptions.ui
plugins/forms/dialogDuplicateFilesFound.ui
plugins/forms/dialogEditor.ui
plugins/forms/dialogExportLocation.ui
plugins/forms/dialogIFSCloud.ui
plugins/forms/dialogMyShortcuts.ui
plugins/forms/dialogOutlookIntegrationOptions.ui
plugins/forms/dialogSSRSOptions.ui
plugins/forms/dialogSettingsMigrator.ui
plugins/forms/dialogTeamMemberQuickAdd.ui
plugins/includes/dialogClassification.ui
plugins/includes/dialogEditor.ui
plugins/includes/dialogFileFinder.ui
plugins/includes/dialogIFSCloud.ui
plugins/includes/dialogMeetingTemplate.ui
plugins/includes/dialogMeetingTypes.ui
plugins/includes/dialogMyShortcuts.ui
plugins/includes/dialogOutlookIntegrationOptions.ui
plugins/examplemeeting.xml
plugins/exampleproject.xml
plugins/people.xml
plugins/plugintest.db
plugins/TestExcel.xlsx
"

for resources_root in \
    "${application_root}/Contents/Resources" \
    "${application_root}/Contents/MacOS"
do
    for script in ${retired_scripts}; do
        script_dir=$(dirname "${script}")
        script_name=$(basename "${script}")
        rm -f "${resources_root}/${script}.py"
        rm -f "${resources_root}/${script_dir}/__pycache__/${script_name}."*.pyc
        rm -f "${resources_root}/${script_dir}/__pycache__/${script_name}."*.pyo
    done
    for retired_file in ${retired_files}; do
        rm -f "${resources_root}/${retired_file}"
    done
    # Any bytecode left in the Python folders, whatever script it came from.
    rm -f "${resources_root}/plugins/__pycache__/"*.pyc "${resources_root}/plugins/__pycache__/"*.pyo
    rm -f "${resources_root}/plugins/includes/__pycache__/"*.pyc "${resources_root}/plugins/includes/__pycache__/"*.pyo
    rm -f "${resources_root}/threads/__pycache__/"*.pyc "${resources_root}/threads/__pycache__/"*.pyo
    # Emptied folders; rmdir leaves any folder that still holds something.
    rmdir "${resources_root}/plugins/__pycache__" 2>/dev/null || true
    rmdir "${resources_root}/plugins/includes/__pycache__" 2>/dev/null || true
    rmdir "${resources_root}/threads/__pycache__" 2>/dev/null || true
    rmdir "${resources_root}/plugins/includes" 2>/dev/null || true
    rmdir "${resources_root}/plugins/forms" 2>/dev/null || true
    # The old shared templates folder goes whole, including any files added
    # to it: document templates now come from each plugin.
    rm -rf "${resources_root}/plugins/templates"
    rmdir "${resources_root}/threads" 2>/dev/null || true
done

# Frameworks and Python packages earlier releases bundled. They belong to the
# app, never to the user, and a leftover copy inside the new bundle would
# break its code signature.
for leftover in \
    "Contents/Frameworks/Python.framework" \
    "Contents/Frameworks/QtWebEngineCore.framework" \
    "Contents/Frameworks/QtWebEngineQuick.framework" \
    "Contents/Frameworks/QtWebChannel.framework" \
    "Contents/Frameworks/QtWebChannelQuick.framework" \
    "Contents/Frameworks/QtPositioning.framework" \
    "Contents/Frameworks/QtPositioningQuick.framework" \
    "Contents/Resources/qml/QtWebEngine" \
    "Contents/Resources/qml/QtWebChannel" \
    "Contents/Resources/qml/QtPositioning" \
    "Contents/Resources/site-packages" \
    "Contents/MacOS/site-packages"
do
    rm -rf "${application_root}/${leftover}"
done

exit 0
