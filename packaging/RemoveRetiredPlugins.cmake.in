    "threads/tester_thread_1"
    # Replaced by JavaScript plugins.
    "plugins/base_plugin"
    "plugins/base_plugin_settings"
    "plugins/excelkill_plugin"
    "plugins/ifs_ssrs_generate_plugin"
    "plugins/ifscloud_plugin_settings"
