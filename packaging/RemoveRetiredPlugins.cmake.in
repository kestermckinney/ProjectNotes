set(_pn_retired_files
    "plugins/forms/dialogClassification.ui"
    "plugins/forms/dialogExportNotesOptions.ui"
    "plugins/forms/dialogExportStatusReportOptions.ui"
    "plugins/forms/dialogExportTrackerOptions.ui"
    "plugins/forms/dialogFileFinder.ui"
    "plugins/forms/dialogMeetingEmailTemplate.ui"
    "plugins/forms/dialogMeetingEmailTypes.ui"
    "plugins/forms/dialogStatusRptOptions.ui"
    "plugins/forms/dialogTrackerOptions.ui"
    "plugins/forms/dialogTrackerRptOptions.ui"
    "plugins/includes/dialogDuplicateFilesFound.ui"
    "plugins/includes/dialogNotesArchiveOptions.ui"
    "plugins/includes/dialogStatusRptOptions.ui"
    "plugins/includes/dialogTrackerRptOptions.ui"
    "plugins/templates/Tracker Items Template.xlsx"
    "plugins/forms/dialogDuplicateFilesFound.ui"
    "plugins/forms/dialogEditor.ui"
    "plugins/forms/dialogExportLocation.ui"
    "plugins/forms/dialogIFSCloud.ui"
    "plugins/forms/dialogMyShortcuts.ui"
    "plugins/forms/dialogOutlookIntegrationOptions.ui"
    "plugins/forms/dialogSSRSOptions.ui"
