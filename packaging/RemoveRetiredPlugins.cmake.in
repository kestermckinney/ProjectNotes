    "plugins/forms/dialogTeamMemberQuickAdd.ui"
    "plugins/templates/Lessons Learned Template.xlsx"
    "plugins/templates/Meeting Template.xlsx"
    "plugins/templates/Risk Register Template.xlsx"
)

# Emptied folders, innermost first. A folder that still holds something (for
# example the user's own files) is left alone.
set(_pn_retired_dirs
    "plugins/__pycache__"
    "plugins/includes/__pycache__"
    "threads/__pycache__"
    "plugins/includes"
    "plugins/forms"
    "plugins/templates"
    "threads"
)

foreach(_pn_script IN LISTS _pn_retired_scripts)
    list(APPEND _pn_retired_files "${_pn_script}.py")
    get_filename_component(_pn_script_dir "${_pn_script}" DIRECTORY)
    get_filename_component(_pn_script_name "${_pn_script}" NAME)
    file(GLOB _pn_bytecode
        "${_pn_runtime_root}/${_pn_script_dir}/__pycache__/${_pn_script_name}.*.pyc"
        "${_pn_runtime_root}/${_pn_script_dir}/__pycache__/${_pn_script_name}.*.pyo"
    )
    if(_pn_bytecode)
        message(STATUS "Removing retired plugin bytecode: ${_pn_script}")
        file(REMOVE ${_pn_bytecode})
    endif()
endforeach()

foreach(_pn_file IN LISTS _pn_retired_files)
    set(_pn_path "${_pn_runtime_root}/${_pn_file}")
    if(EXISTS "${_pn_path}" OR IS_SYMLINK "${_pn_path}")
        message(STATUS "Removing retired plugin file: ${_pn_path}")
        file(REMOVE "${_pn_path}")
    endif()
endforeach()

foreach(_pn_dir IN LISTS _pn_retired_dirs)
    set(_pn_path "${_pn_runtime_root}/${_pn_dir}")
    if(IS_DIRECTORY "${_pn_path}" AND NOT IS_SYMLINK "${_pn_path}")
        file(GLOB _pn_left "${_pn_path}/*")
        if(NOT _pn_left)
            message(STATUS "Removing empty retired folder: ${_pn_path}")
            file(REMOVE_RECURSE "${_pn_path}")
        endif()
    endif()
endforeach()

unset(_pn_bytecode)
unset(_pn_dir)
unset(_pn_left)
unset(_pn_retired_dirs)
unset(_pn_file)
unset(_pn_path)
unset(_pn_retired_files)
unset(_pn_retired_scripts)
unset(_pn_script)
unset(_pn_script_dir)
unset(_pn_script_name)
unset(_pn_runtime_root)
unset(_pn_install_bindir)
