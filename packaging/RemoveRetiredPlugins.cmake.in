# CMake directory installs and the Windows deploy copy both merge into their
# destination, so plugins removed from the source tree can otherwise survive an
# upgrade. This removes every bundled Python plugin, thread, form and helper an
# earlier release shipped (Python plugins no longer run at all), then the
# folders they lived in once they are empty. Files are named one by one because the plugins folder can also hold
# the user's own plugins; it is never removed recursively.
#
# Keep this list in step with packaging/windows/remove_retired_plugins.nsh and
# packaging/macos/projectnotes-scripts/preinstall.
#
# Run as an install(SCRIPT), or directly with
#   cmake -DPN_RUNTIME_ROOT=<dir holding plugins/ and threads/> -P RemoveRetiredPlugins.cmake
if(DEFINED PN_RUNTIME_ROOT)
    set(_pn_runtime_root "${PN_RUNTIME_ROOT}")
else()
    set(_pn_install_bindir "@CMAKE_INSTALL_BINDIR@")
    if(IS_ABSOLUTE "${_pn_install_bindir}")
        set(_pn_runtime_root "$ENV{DESTDIR}${_pn_install_bindir}")
    else()
        set(_pn_runtime_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${_pn_install_bindir}")
    endif()
endif()

# Scripts, listed without .py so their cached bytecode goes too.
